PROJECT_NAME="Darukaa.Earth API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
SECRET_KEY="your_jwt_secret_key_here"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=darukaa
POSTGRES_PASSWORD=darukaa_secret
POSTGRES_DB=darukaa_earth
DATABASE_URL=postgresql://darukaa:darukaa_secret@localhost:5432/darukaa_earth

# Production (Azure PostgreSQL + Render) — set DATABASE_URL to override POSTGRES_* vars.
# ENVIRONMENT="production" enforces strict PostgreSQL connection & disables SQLite fallback.
# DATABASE_URL=postgresql://<username>:<password>@<server>.postgres.database.azure.com:5432/postgres

